# Copy to server/.env (gitignored) and load with your shell or direnv.
DATABASE_URL=postgres://sdd:sdd@localhost:5432/sdd?sslmode=disable
# Used by `go test`; this database is reset by the migration tests.
TEST_DATABASE_URL=postgres://sdd:sdd@localhost:5432/sdd_test?sslmode=disable
PORT=8080
# Where browsers reach the app. In dev that's Vite, which proxies /api here.
PUBLIC_URL=http://localhost:5173
# A GitHub OAuth app (github.com/settings/developers) with callback
# http://localhost:5173/api/auth/github/callback. Leave empty to run with sign-in off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your numeric GitHub user ID (curl -s https://api.github.com/users/<login> | grep '"id"').
ADMIN_GITHUB_IDS=
LOG_FORMAT=text
LOG_LEVEL=debug
