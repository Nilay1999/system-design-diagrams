{
  "name": "system-design-diagrams",
  "private": true,
  "version": "1.0.0",
  "description": "System design documents with interactive Excalidraw diagrams, served by a React + Vite app.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-excalidraw-assets.mjs",
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/build-icons.mjs",
    "api:types": "npx -y -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript server/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tanstack/react-query": "^5.104.1",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
