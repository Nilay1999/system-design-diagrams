{
  "name": "system-design-diagrams",
  "private": true,
  "version": "1.0.0",
  "description": "System design documents with interactive Excalidraw diagrams, served by a React + Vite app.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-excalidraw-assets.mjs",
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
